# Copy to .env (local) or configure the same names in your host.
# NEVER commit real secrets.

# Public frontend origin. OAuth callbacks must use this origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side API origin used by the Next.js /api rewrite. Keep the browser's
# API base relative (/api) so the host-only session cookie stays first-party.
BACKEND_URL=http://localhost:8000

# Optional browser override. Leave unset for cookie auth. If set, it MUST point
# at the same host as the frontend, otherwise the session cookie is not sent.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# NEXT_PUBLIC_API_URL=

# AES-256 key for secure-media URLs. Must match backend AES_SECRET_KEY.
# Generate with: openssl rand -base64 32
NEXT_PUBLIC_AES_SECRET_KEY=

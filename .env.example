# QuizSupport production Docker environment
#
# Copy to .env and replace every placeholder. Never commit .env.
#   cp .env.example .env
#   chmod 600 .env
#
# Generate strong secrets with:
#   openssl rand -hex 32

# ── Images / host port ────────────────────────────────────────────────────────
# Increment per release so the previous image is kept for rollback.
IMAGE_TAG=local
# Bound to 127.0.0.1 only (tunnel ingress), never 0.0.0.0.
API_PORT=8000

# ── PostgreSQL (bundled container) ────────────────────────────────────────────
POSTGRES_DB=quizsupport
POSTGRES_USER=quizsupport
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# If the password contains URL-reserved characters (@ : / ? # [ ]), percent-encode
# them here or generate a URL-safe password.
# Host "postgres" is the Compose service name.
DATABASE_URL=postgresql://quizsupport:replace-with-a-long-random-database-password@postgres:5432/quizsupport
# false for the bundled PostgreSQL (no TLS on the private network).
# Set true (or verify-full) when pointing DATABASE_URL at a managed provider.
DATABASE_SSL=false
# Optional transaction-pooler URL for managed providers; empty keeps the API
# on DATABASE_URL. Migrations always use DATABASE_URL.
DATABASE_POOL_URL=
  
# ── Redis (bundled container) ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Public origins / sessions ─────────────────────────────────────────────────
# Comma-separated browser origins allowed by the backend CORS layer. This is
# the existing frontend host (Vercel or wherever it is deployed).
FRONTEND_URL=https://www.quizsupport.com,https://quizsupport.com
# REQUIRED. Use a fresh 32-byte hex value. Must stay stable while sessions
# exist; rotating it logs every user out.
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_EXPIRY=10d
# REQUIRED. AES-256-GCM key for secure media/brand logo envelopes. The
# frontend needs the same value in its own NEXT_PUBLIC_AES_SECRET_KEY.
AES_SECRET_KEY=replace-with-openssl-rand-hex-32
# Optional separate owner-dashboard signing key. Derived from JWT_SECRET if empty.
PLATFORM_JWT_SECRET=
PLATFORM_JWT_EXPIRY=12h
# Comma-separated role names that may access the platform console. Matched by
# name (not hardcoded id), because role ids differ between databases.
PLATFORM_OWNER_ROLES=admin
# Optional comma-separated owner email allowlist.
PLATFORM_OWNER_EMAILS=

# ── AI providers (optional, choose one) ──────────────────────────────────────
# Primary configuration; provider-specific keys below are fallbacks.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TEMPERATURE=
AI_MAX_OUTPUT_TOKENS=
OPENAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Local LM Studio is only reachable if it listens outside the container.
LM_STUDIO_URL=
LM_STUDIO_MODEL=
LM_STUDIO_MODEL_CODER=
LM_STUDIO_MODEL_TESTOR=

# ── Document AI / question import (optional) ─────────────────────────────────
# Empty = Docling is unavailable; the backend falls back to local PDF/DOCX
# text extraction. Do not point this at localhost from inside the API container.
DOCLING_URL=
DOCLING_TIMEOUT_MS=60000
DOCUMENT_AI_BASE_URL=
DOCUMENT_AI_MODEL=
DOCUMENT_AI_CHAR_LIMIT=
PAPER_MAX_OUTPUT_TOKENS=

# ── Email / OTP delivery (required for registration/login) ───────────────────
# Option A: Resend
RESEND_API_KEY=
RESEND_FROM=
# Option B: SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Option C: legacy Gmail app-password fallback
EMAIL1=
GMAIL_APP_NAME1=
GMAIL_APP_PASSWORD1=

# ── Judge0 (optional) ────────────────────────────────────────────────────────
# Focus mode currently blocks the code-execution pages. If enabled later,
# point this at a remote Judge0 CE instance; do not run Judge0 on this VPS
# unless you have capacity for its own PostgreSQL/Redis/isolate stack.
JUDGE0_API_URL=
JUDGE0_API_KEY=

# ── Queue tuning (optional; defaults shown) ──────────────────────────────────
# PDF/Chromium rendering is memory-heavy. Two concurrent renders is the safe
# default on a 4 vCPU / 8 GB host.
PDF_QUEUE_CONCURRENCY=2
EMAIL_QUEUE_CONCURRENCY=2
QUIZ_SUBMISSION_CONCURRENCY=5
QUIZ_RECALCULATION_CONCURRENCY=2

# ── Sync scripts (not used by the runtime containers) ────────────────────────
# LOCAL_DATABASE_URL=
# CLOUD_DATABASE_URL=
# SOURCE_DATABASE_URL=
# TARGET_DATABASE_URL=
# SYNC_SOURCE_URL=
# SYNC_TARGET_URL=

{
  "name": "code-judge-backend",
  "version": "1.0.0",
  "description": "Backend service for byteclash platform",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start-redis": "redis-server",
    "dev:server": "tsx watch src/server.ts",
    "dev": "concurrently \"npm run start-redis\" \"npm run dev:server\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "migration:dry": "tsx src/migrate.ts --dry-run"
  },
  "dependencies": {
    "@prisma/client": "^5.6.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.3",
    "otp-generator": "^4.0.1",
    "pg": "^8.22.0",
    "playwright": "^1.62.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "redis": "^6.1.0",
    "uuid": "^14.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/otp-generator": "^4.0.2",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "concurrently": "^10.0.4",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "prisma": "^5.6.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}

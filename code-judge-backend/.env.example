# ---------------------------------------------------------------------------
# QuizSupport backend — copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------
NODE_ENV=development

# Core services
DATABASE_URL=postgresql://quizsupport:change-me@127.0.0.1:5432/quizsupport
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRY=10d

# Browser origin (also used for OAuth post-login redirects). In production this
# is the public frontend origin, e.g. https://www.quizsupport.com.
FRONTEND_URL=http://localhost:3000

# OAuth callback base = the public frontend origin. The callback must go
# through the Next.js /api rewrite so the session cookie stays first-party.
# Leave blank to use FRONTEND_URL.
OAUTH_CALLBACK_BASE_URL=http://localhost:3000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Other existing services (only needed by the features you use)
RESEND_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AES_SECRET_KEY=

# Country pricing and payment gating.
# Only add currencies after confirming they are enabled for this Razorpay account.
RAZORPAY_SUPPORTED_CURRENCIES=INR
# Direct TCP peers allowed to set CF-IPCountry and CF-Connecting-IP. Exact IPs
# or CIDR ranges (IPv4/IPv6), comma-separated. The peer is the socket address,
# never X-Forwarded-For. Empty = headers are never trusted (fail closed).
# Cloudflare edge ranges (only if the origin is reachable directly from Cloudflare,
# not via a tunnel): https://www.cloudflare.com/ips-v4 and https://www.cloudflare.com/ips-v6
# Tunnel deployments: set this to the address the API sees from the tunnel connector.
GEO_TRUSTED_PROXY_IPS=
# Dev-only ?country= override is ignored when NODE_ENV=production (or VERCEL=1 / VERCEL_ENV=production).
# Shared server-only HMAC secret used by the frontend SSR proxy for trusted geo.
PRICING_GEO_SHARED_SECRET=
# Optional ISO country used when no IP/mobile signal is available (e.g. local dev).
PRICING_DEFAULT_COUNTRY=
